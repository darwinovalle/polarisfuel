# Django
SECRET_KEY=django-insecure-dev-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL)
DB_NAME=routefuel_db
DB_USER=routefuel_user
DB_PASSWORD=routefuel_password
DB_HOST=db
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Fuel import
EXCEL_SOURCE_PATH=/app/fuel-prices.csv
AUTO_IMPORT_ON_STARTUP=0

# TomTom API
TOMTOM_API_KEY=replace-with-your-tomtom-api-key

# Container role: web | worker | beat
CONTAINER_ROLE=web
RUN_MIGRATIONS=0

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
